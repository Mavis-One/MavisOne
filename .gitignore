node_modules/
.vscode/
*.log
logs/
.env

# Estado de execução, não código: o db.json é recriado por ensureDataFile() no
# primeiro boot e cada saveData() reescreve o arquivo inteiro, o que sujava o
# histórico a cada operação. Enquanto o Financeiro não migra para o Supabase,
# este arquivo é a base local de cada máquina — não deve ser versionado.
data/
supabase/.temp/

# Configuração do rclone usada pelo serviço `envio`: guarda credencial de
# acesso ao destino dos backups (chave, token, senha). O modelo versionado é o
# deploy/rclone.conf.exemplo; o arquivo real fica só na máquina.
deploy/rclone/
