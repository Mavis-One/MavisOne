# Copie este arquivo para ".env" e preencha com os valores do seu projeto
# Supabase (Project Settings > API no painel do Supabase). Não faça commit
# do ".env" com os valores reais.

# URL do projeto (ex.: https://xxxxxxxxxxxx.supabase.co)
SUPABASE_URL=

# service_role key (NÃO é a anon key) — usada só no backend, nunca no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Focus NFe (https://focusnfe.com.br) — emissão de NF-e/NFC-e/NFS-e.
# Gere o token no painel da Focus NFe (ambiente de homologação ou produção).
FOCUS_NFE_TOKEN=

# homologacao (padrão, sem valor fiscal) ou producao
FOCUS_NFE_AMBIENTE=homologacao

# Chave de 32 bytes em base64 pra criptografar o token da Focus NFe de cada
# estabelecimento em repouso. Gere uma com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# NUNCA troque depois de já existirem tokens salvos.
FOCUS_TOKEN_ENCRYPTION_KEY=

# Webhook: URL pública (produção) que a Focus NFe chama quando o status de
# uma NF-e muda de forma assíncrona, e o segredo que ela devolve no header
# X-Fiscal-Webhook-Secret pra validar a autenticidade da chamada. Gere o
# segredo com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FISCAL_WEBHOOK_URL=
FISCAL_WEBHOOK_SECRET=
