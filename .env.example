# Copie este arquivo para ".env" e preencha. Não faça commit do ".env" com os
# valores reais.

# ---------------------------------------------------------------------------
# BANCO — Postgres em Docker (o docker-compose.yml deste repositório)
# ---------------------------------------------------------------------------
# Uma variável só, no formato que psql, pg_dump e Portainer entendem. Para o
# container padrão do repositório, o valor é exatamente este:
DATABASE_URL=postgres://mavisone:mavisone@localhost:5432/mavisone

# A senha acima é padrão de DESENVOLVIMENTO, e serve porque o compose prende a
# porta em 127.0.0.1 — o banco não é alcançável de fora da máquina. Na VPS,
# defina POSTGRES_PASSWORD na stack e repita a senha aqui.

# Opcionais, com padrão razoável. Só mexa se souber por quê.
# DATABASE_POOL_MAX=10
# DATABASE_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# BACKUP AUTOMÁTICO (serviço `backup` do docker-compose.yml)
# ---------------------------------------------------------------------------
# Ele sobe junto com o banco e não precisa de configuração nenhuma: os padrões
# abaixo já valem. Estão aqui para quando você quiser mudar, e para você saber
# que existem.
#
# O gatilho NÃO é um horário, é uma idade: "não existe cópia das últimas X
# horas? tire uma agora". Num computador que é desligado às 18h, um agendamento
# para as 03:00 nunca dispara — e a falha é silenciosa, uma pasta que parou de
# crescer. Assim, a cópia sai quando a máquina liga.
# BACKUP_INTERVALO_HORAS=24

# NA VPS, DESCOMENTE E USE "03". A VPS fica ligada 24h, então lá vale fixar a
# hora: sem isto a cópia diária cai no horário em que a stack subiu, que é um
# horário de movimento. Vazio (o padrão) é o certo nesta máquina, que é
# desligada à noite e nunca veria as 03:00 chegarem.
# BACKUP_HORA=03

# NA VPS, APONTE PARA FORA DO CLONE DO REPOSITÓRIO — de preferência para um
# disco que sobreviva à máquina. Backup dentro da pasta do projeto morre junto
# com a pasta do projeto.
# BACKUP_DESTINO=/mnt/backups

# Quantos dias de backup guardar em data/backup...
# BACKUP_RETENCAO_DIAS=30

# ...mas nunca descendo abaixo desta quantidade de arquivos. É o que impede que
# um banco parado por mais de BACKUP_RETENCAO_DIAS acabe com a poda apagando a
# última cópia que restou.
# BACKUP_MINIMO_ARQUIVOS=3

# Confira quando quiser se a automação está viva:  npm run backup:estado

# ---------------------------------------------------------------------------
# ENVIO PARA FORA DA MÁQUINA (serviço `envio`, via rclone)
# ---------------------------------------------------------------------------
# O serviço `backup` protege contra erro humano; ele NÃO protege contra a
# máquina morrer, porque a cópia está dentro dela. Este é o outro lado, e ele
# fica DESLIGADO até você ligar — sem destino configurado não teria o que fazer.
#
# Antes de ligar: gere o rclone.conf (veja deploy/rclone.conf.exemplo) e
# coloque-o em deploy/rclone/rclone.conf.
# COMPOSE_PROFILES=envio

# O nome do remoto no rclone.conf + o caminho lá dentro.
# ENVIO_REMOTO=b2:mavisone-backups

# De quanto em quanto tempo ele procura arquivo novo para subir.
# ENVIO_INTERVALO_MINUTOS=30

# VAZIO = NUNCA APAGA NADA NO DESTINO, e é o padrão de propósito. Guardar mais
# tempo fora da máquina do que dentro dela costuma ser o certo, e um comando que
# apaga no remoto por engano apaga justamente a cópia que existia para quando
# tudo o mais falhasse.
# ENVIO_RETENCAO_DIAS=

# O rclone lê a própria configuração do ambiente, então qualquer RCLONE_* vale
# aqui sem precisar mexer no compose. Este é o mais útil: não comer a banda da
# VPS no horário comercial.
# RCLONE_BWLIMIT=2M

# As variáveis SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY não são mais lidas por
# nada: o sistema saiu do Supabase e fala SQL direto com o Postgres. Se elas
# ainda estiverem no seu .env, pode apagar.

# Focus NFe (https://focusnfe.com.br) — emissão de NF-e/NFC-e/NFS-e.
# Gere o token no painel da Focus NFe (ambiente de homologação ou produção).
FOCUS_NFE_TOKEN=

# homologacao (padrão, sem valor fiscal) ou producao
FOCUS_NFE_AMBIENTE=homologacao

# Trava de segurança. Com ela ligada (1), NENHUMA emissão sai para produção —
# nem por estabelecimento salvo como "producao". A tela bloqueia a opção e o
# servidor recusa a chamada. O padrão, se a variável não existir, é LIGADA:
# ir para produção precisa ser um ato explícito, porque nota autorizada não
# tem desfazer (só cancelamento dentro do prazo).
# Para emitir de verdade um dia: FOCUS_NFE_SOMENTE_HOMOLOGACAO=0
FOCUS_NFE_SOMENTE_HOMOLOGACAO=1

# Chave de 32 bytes em base64 pra criptografar o token da Focus NFe de cada
# estabelecimento em repouso. Gere uma com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# NUNCA troque depois de já existirem tokens salvos.
FOCUS_TOKEN_ENCRYPTION_KEY=

# Webhook: URL pública (produção) que a Focus NFe chama quando o status de
# uma NF-e muda de forma assíncrona, e o segredo que ela devolve no header
# X-Fiscal-Webhook-Secret pra validar a autenticidade da chamada. Gere o
# segredo com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FISCAL_WEBHOOK_URL=
FISCAL_WEBHOOK_SECRET=

# Open Finance — conexão bancária (Pluggy, Polp ou Celcoin). Deixe em branco
# até ter uma conta de teste com um desses agregadores; enquanto vazio, o
# módulo funciona só no modo manual/CSV que já existe hoje.
# pluggy, polp ou celcoin (vazio = nenhum provider ativo)
OPEN_FINANCE_PROVIDER=
OPEN_FINANCE_CLIENT_ID=
OPEN_FINANCE_CLIENT_SECRET=
OPEN_FINANCE_API_URL=
# sandbox (padrão) ou production
OPEN_FINANCE_ENVIRONMENT=sandbox
# Segredo que o provider devolve no header de autenticação do webhook. Gere
# com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OPEN_FINANCE_WEBHOOK_SECRET=
# Chave própria (independente da FOCUS_TOKEN_ENCRYPTION_KEY) pra criptografar
# em repouso as credenciais de conexão bancária. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# NUNCA troque depois de já existirem conexões salvas.
OPEN_FINANCE_ENCRYPTION_KEY=
